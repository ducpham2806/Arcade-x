{
  "name": "arcadex",
  "private": true,
  "version": "2.12.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/build-duel-worker.mjs && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:supabase": "bash tests/run-supabase.sh",
    "test:auth": "playwright test tests/auth",
    "test:qc": "playwright test",
    "test:pwa": "node tests/qc/manual/pwa.cjs",
    "test:shikaku": "node tests/qc/manual/shikaku-repro.cjs",
    "test:update": "node tests/qc/manual/update.cjs",
    "test:blossom": "playwright test tests/blossom",
    "audit:blossom-seeds": "node scripts/run-blossom-seed-audit.mjs",
    "simulate:blossom": "node scripts/run-blossom-simulation.mjs 1000 tests/blossom/balance-results.json",
    "preview:blossom": "node scripts/blossom-preview.mjs",
    "preview:launcher": "npm run build && node scripts/launcher-preview.mjs",
    "preview:rainbow": "node scripts/rainbow-preview.mjs",
    "test:rainbow": "playwright test tests/rainbow",
    "test:readability": "node tests/readability/contrast.mjs && node tests/readability/dom-policy.cjs",
    "test:duel": "node tests/duel/engines.mjs && node tests/duel/ui.cjs && node tests/duel/worker.mjs",
    "test:social": "node tests/social/audio.mjs && node tests/social/ui.cjs",
    "export:artwork": "node scripts/export-game-art.mjs",
    "test:artwork": "node tests/artwork/catalog.mjs && node tests/artwork/access.mjs && node tests/artwork/chronicles.cjs",
    "test:startup": "node tests/pwa/startup.cjs && node tests/pwa/packages.cjs",
    "test:boom-art": "node tests/boom-buddies/art-v3.mjs",
    "preview:boom-art": "node scripts/boom-art-preview.mjs",
    "test:boom-pip": "node tests/boom-buddies/pip-v4.mjs",
    "export:boom-pip": "node scripts/export-pip-v4-review.mjs",
    "test:cosmic-levels": "node --test tests/cosmic/encounters-v4.mjs tests/cosmic/encounters-v5.mjs",
    "preview:cosmic-levels": "node scripts/export-cosmic-level-review.mjs",
    "test:eat": "node scripts/test-eat-journey.mjs",
    "export:eat-art": "node scripts/export-eat-art.mjs",
    "preview:eat": "node scripts/export-eat-review.mjs",
    "simulate:eat-economy": "node scripts/simulate-eat-economy.mjs",
    "test:subscriptions": "node scripts/test-subscriptions.mjs && node tests/subscriptions/access-client.mjs",
    "test:commerce": "node --test tests/subscriptions/payment-core.mjs tests/subscriptions/orders-http.mjs tests/subscriptions/orders-client.mjs tests/subscriptions/admin-reviews.mjs tests/subscriptions/checkout-flow.mjs tests/subscriptions/reconciliation.mjs",
    "test:battleship": "node tests/battleship/engine.mjs && node tests/battleship/next-milestone.mjs && node tests/battleship/persistence.mjs && node tests/battleship/edge-handler.mjs && node tests/battleship/online-integration.mjs && node tests/battleship/presence.mjs && node tests/battleship/maintenance.mjs && node tests/battleship/matchmaking.mjs && node tests/battleship/squad-online.mjs && node tests/battleship/rematch.mjs && node tests/battleship/audio.mjs",
    "preview:battleship": "node scripts/battleship-preview.mjs",
    "prepare:battleship-server": "node scripts/battleship-server-package.mjs",
    "test:full-release": "node tests/integration/full-release.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "chess.js": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.21",
    "linkedom": "^0.18.12",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "@electric-sql/pglite": "0.5.10"
  }
}
