# Start from the repository root with Node >=22.18 (24 recommended).
HOST=127.0.0.1
PORT=3000
# Explicit local review only; omit to require verified Supabase identity.
# TANK_REVIEW_MODE=1
TANK_ALLOWED_ORIGINS=https://your-review-host.example
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Test access, not a subscription entitlement implementation.
TANK_ALLOWED_USER_IDS=verified-user-uuid-one,verified-user-uuid-two
