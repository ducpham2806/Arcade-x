# Copy OUTSIDE the checkout to /etc/arcadex-tank/staging.env (chmod 600).
NODE_ENV=production
TANK_ENV=staging
HOST=127.0.0.1
PORT=3223
TANK_MAX_CONNECTIONS=64
# Exact HTTPS frontend origin(s), comma separated; no wildcard/path/trailing slash.
TANK_ALLOWED_ORIGINS=https://review.example.com
SUPABASE_URL=https://STAGING_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_STAGING_PUBLISHABLE_KEY
# Registered Auth user UUIDs from the staging project, comma separated.
TANK_ALLOWED_USERS=REPLACE_WITH_TESTER_UUIDS
# Generate with: openssl rand -hex 32
TANK_METRICS_TOKEN=REPLACE_WITH_RANDOM_TOKEN
# Frontend public settings live in a separate build env; see TC2-RUNBOOK.md.
