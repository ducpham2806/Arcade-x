# Frontend Supabase configuration. These two public values are embedded at build time.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
# Optional public HTTPS callback URL (must be allowed in Supabase Auth).
# Local HTML files otherwise use the project's configured Site URL.
# VITE_AUTH_REDIRECT_URL="https://your-launcher.example/"
# Staging only: requires subscription_foundation migration and explicit admin membership.
# Rollout order, checks and rollback for every commerce flag: docs/COMMERCE-ROLLOUT.md
# Defaults off; does not enable checkout. Use a separate staging Supabase project.
VITE_ACCESS_CONTROL_V2=false

# Enable only after deploying the authenticated, durable rental-order HTTP adapter.
# Does not enable store checkout or payment collection. Requires access preview too.
VITE_RENTAL_ORDERS_API=false

# Admin review also needs durable admin membership, queue and command/audit adapters.
# Independent of order history and checkout; leave off until those adapters are ready.
VITE_RENTAL_REVIEW_API=false

# Requires durable checkout records and a configured verified payment-provider adapter.
# Frontend checkout also requires VITE_RENTAL_ORDERS_API=true. Defaults off.
VITE_RENTAL_CHECKOUT_API=false

# Internal order/grant consistency scan; requires protected server route
VITE_RENTAL_RECONCILIATION_API=false
