rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Matchmaking Queue
    match /matchmaking_queue/{queueId} {
      allow read: if true;
      allow create: if incoming().uid is string
                    && incoming().gameId is string
                    && incoming().status in ['waiting', 'matched', 'cancelled']
                    && incoming().createdAt is number;
      allow update: if incoming().status in ['waiting', 'matched', 'cancelled'];
      allow delete: if true;
    }

    // Game Rooms
    match /game_rooms/{roomId} {
      allow read: if true;
      allow create: if incoming().roomId is string
                    && incoming().gameId is string
                    && incoming().roomCode is string
                    && incoming().status in ['waiting', 'ready', 'playing', 'ended', 'finished', 'abandoned'];
      allow update: if incoming().status in ['waiting', 'ready', 'playing', 'ended', 'finished', 'abandoned'];
      allow delete: if true;

      // Subcollection of moves
      match /moves/{moveId} {
        allow read: if true;
        allow create: if incoming().moveIndex is number
                      && incoming().playerId is string
                      && incoming().symbol is string;
        allow update: if false;
        allow delete: if false;
      }
    }

    // Chat Messages
    match /chat_messages/{messageId} {
      allow read: if true;
      allow create: if incoming().text is string 
                    && incoming().senderName is string
                    && incoming().text.size() <= 1000;
      allow update: if incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'likedBy']);
      allow delete: if false;
    }

    // Leaderboards
    match /leaderboards/{boardId}/scores/{scoreId} {
      allow read: if true;
      allow create, update: if incoming().score is number
                            && incoming().playerName is string;
      allow delete: if false;
    }

    // Daily 24H Leaderboards
    match /daily_leaderboards/{dailyBoardId}/scores/{scoreId} {
      allow read: if true;
      allow create, update: if incoming().score is number
                            && incoming().playerName is string;
      allow delete: if false;
    }

    // Daily Challenges
    match /daily_challenges/{challengeId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Players profiles & synced cloud data
    match /players/{playerId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;

      // Player Inventory Subcollection
      match /inventory_data/{docId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if false;
      }

      // Player Game Sessions Subcollection (Cross-device auto-save / resume)
      match /game_sessions/{sessionId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if true;
      }
    }

    // Friends and Social Network
    match /friends/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Friend 1v1 PvP Challenges
    match /friend_challenges/{challengeId} {
      allow read: if true;
      allow create: if incoming().senderUid is string
                    && incoming().targetUid is string
                    && incoming().gameId is string
                    && incoming().status in ['pending', 'accepted', 'declined', 'expired', 'completed'];
      allow update: if incoming().status in ['pending', 'accepted', 'declined', 'expired', 'completed'];
      allow delete: if true;
    }

    // Weekly Quests & Retention Progression
    match /weekly_quests/{questDocId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Default catch-all
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
