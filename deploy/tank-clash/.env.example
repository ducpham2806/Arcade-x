# Copy to .env locally. Never commit real credentials. Use a separate staging Supabase project.
TANK_DOMAIN=tank-staging.example.com
ACME_EMAIL=owner@example.com
TANK_ALLOWED_ORIGINS=https://tank-staging.example.com
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
TANK_ALLOWED_USER_IDS=first-registered-user-uuid,second-registered-user-uuid
